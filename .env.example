# Backend API base URL (transit-flow-be)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3002

# Vector tile style JSON URL (e.g. MapTiler / OpenFreeMap)
NEXT_PUBLIC_MAPLIBRE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Optional API key for the tile provider, if required
# NEXT_PUBLIC_MAPLIBRE_API_KEY=

# Default map viewport (Jakarta)
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LAT=-6.2088
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LNG=106.8272
NEXT_PUBLIC_DEFAULT_MAP_ZOOM=11
